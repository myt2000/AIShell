.modal-content
    .modal-header
        h5.modal-title {{ 'Batch commands'|translate }}
        button.btn.btn-link.close(type='button', (click)='cancel()') ×
    .modal-body
        .mb-3
            .d-flex.align-items-center.mb-1
                label.form-label.mb-0.me-auto {{ 'Open terminal tabs'|translate }} ({{ checkedTabs.length }}/{{ openTabs.length }})
                button.btn.btn-sm.btn-secondary(type='button', (click)='refreshTabs()')
                    i.fas.fa-rotate.me-1(aria-hidden='true')
                    | {{ 'Refresh tab list'|translate }}
            .tab-checklist(*ngIf='openTabs.length')
                label.tab-entry(*ngFor='let e of openTabs')
                    input(type='checkbox', [(ngModel)]='e.checked')
                    .tab-entry-info
                        .tab-entry-name(title='{{e.title}}') {{ e.title }}
                        .tab-entry-target.text-muted(*ngIf='e.target') {{ e.target }}
            .alert.alert-warning.py-2(*ngIf='!openTabs.length') {{ 'No open terminal tabs. Connect to servers first.'|translate }}

        .mb-3
            label.form-label {{ 'Commands, one per line'|translate }}
            textarea.form-control.command-input(
                rows='6',
                [(ngModel)]='commandText',
                placeholder='uptime\ndf -h'
            )
            .form-text.text-muted {{ 'Variables like $SERVER_IP / $SERVER_NAME are replaced per target.'|translate }}
    .modal-footer
        button.btn.btn-primary(
            type='button',
            [disabled]='!canRun',
            (click)='run()'
        )
            span(*ngIf='!running') {{ 'Send'|translate }}
            span(*ngIf='running') {{ 'Running…'|translate }}
        button.btn.btn-secondary(type='button', (click)='cancel()') {{ 'Cancel'|translate }}
