.modal-content
    .modal-header
        h5.modal-title {{ 'Batch commands'|translate }}
        button.btn.btn-link.close(type='button', (click)='cancel()') ×
    .modal-body
        .mb-3
            label.form-label {{ 'Targets'|translate }}
            .form-check
                input.form-check-input(type='radio', id='target-selected', name='targetMode', [(ngModel)]='targetMode', value='selected')
                label.form-check-label(for='target-selected') {{ 'Selected servers'|translate }} ({{ selectedProfileIds.size }})
            .form-check
                input.form-check-input(type='radio', id='target-open', name='targetMode', [(ngModel)]='targetMode', value='openTabs')
                label.form-check-label(for='target-open') {{ 'All open terminal tabs'|translate }}
            .form-check
                input.form-check-input(type='radio', id='target-group', name='targetMode', [(ngModel)]='targetMode', value='group')
                label.form-check-label(for='target-group') {{ 'All servers in group'|translate }}

        .mb-3(*ngIf='targetMode === "selected"')
            .d-flex.align-items-center.mb-1
                select.form-control.form-control-sm.me-2([(ngModel)]='selectedGroupId')
                    option(value='') {{ 'Pick group to select…'|translate }}
                    option(*ngFor='let g of groups', [value]='g.id') {{ g.name }}
                button.btn.btn-sm.btn-secondary(type='button', [disabled]='!selectedGroupId', (click)='selectGroupProfiles()') {{ 'Select'|translate }}
            .profile-checklist
                .form-check(*ngFor='let p of profiles')
                    input.form-check-input(
                        type='checkbox',
                        [id]='"chk-" + p.id',
                        [checked]='selectedProfileIds.has(p.id ?? "")',
                        (change)='toggleProfile(p.id)'
                    )
                    label.form-check-label([for]='"chk-" + p.id') {{ p.name }}

        .mb-3(*ngIf='targetMode === "group"')
            select.form-control([(ngModel)]='selectedGroupId')
                option(*ngFor='let g of groups', [value]='g.id') {{ g.name }}

        .mb-3
            label.form-label {{ 'Commands, one per line'|translate }}
            textarea.form-control.command-input(
                rows='6',
                [(ngModel)]='commandText',
                placeholder='uptime\ndf -h'
            )
            .form-text.text-muted {{ 'Variables like $SERVER_IP / $SERVER_NAME are replaced per target.'|translate }}
    .modal-footer
        button.btn.btn-primary(
            type='button',
            [disabled]='!commands.length || running || (targetMode === "selected" && !selectedProfileIds.size) || (targetMode === "group" && !selectedGroupId)',
            (click)='run()'
        )
            span(*ngIf='!running') {{ 'Send'|translate }}
            span(*ngIf='running') {{ 'Running…'|translate }}
        button.btn.btn-secondary(type='button', (click)='cancel()') {{ 'Cancel'|translate }}
