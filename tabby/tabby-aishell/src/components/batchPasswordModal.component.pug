.modal-header
    h5.modal-title {{ 'Batch change passwords'|translate }}
    button.btn.btn-link.close(type='button', (click)='cancel()') ×

.modal-body
    .alert.alert-info.py-2 {{ 'Two kinds of passwords are used: the SSH login password (bastion/direct), and the jump password typed by the login script. Fill only what you want to change.'|translate }}

    .mb-3
        label.form-label {{ 'New SSH login password'|translate }}
        .input-group
            input.form-control(
                [type]='showPasswords ? "text" : "password"',
                [(ngModel)]='sshPassword',
                autocomplete='off'
            )
            button.btn.btn-secondary(type='button', (click)='showPasswords = !showPasswords')
                i.fas.fa-eye-slash(*ngIf='showPasswords', aria-hidden='true')
                i.fas.fa-eye(*ngIf='!showPasswords', aria-hidden='true')
        .form-text.text-muted {{ 'Applies to {n} profiles'|translate: {n: withSshAuth} }}

    .mb-3
        label.form-label {{ 'New jump target password'|translate }}
        .input-group
            input.form-control(
                [type]='showPasswords ? "text" : "password"',
                [(ngModel)]='jumpPassword',
                autocomplete='off'
            )
        .form-text.text-muted {{ 'Applies to {n} profiles'|translate: {n: withJumpStep} }}

    hr
    .text-muted {{ 'Scope'|translate }}: {{ scopeLabel }} · {{ '{n} profiles'|translate: {n: total} }}

.modal-footer
    button.btn.btn-primary(type='button', [disabled]='!canApply', (click)='apply()') {{ 'Apply'|translate }}
    button.btn.btn-secondary(type='button', (click)='cancel()') {{ 'Cancel'|translate }}
