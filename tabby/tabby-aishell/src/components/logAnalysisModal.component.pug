.modal-header
    h5.modal-title {{ 'Multi-window log analysis'|translate }}
    .btn-group
        button.btn.btn-sm.btn-secondary(
            type='button',
            [ngbTooltip]='"Settings"|translate',
            (click)='openSettings()'
        ): i.fas.fa-gear(aria-hidden='true')
        button.btn.btn-sm.btn-secondary(
            type='button',
            [ngbTooltip]='"Close"|translate',
            (click)='cancel()'
        ): i.fas.fa-xmark(aria-hidden='true')

.modal-body.log-analysis-body
    .targets-pane
        h6 {{ 'Targets'|translate }}

        .target-group-title {{ 'Terminal tabs'|translate }}
        button.btn.btn-sm.btn-secondary.w-100.mb-1(
            type='button',
            (click)='refreshTabs()'
        )
            i.fas.fa-rotate.me-1(aria-hidden='true')
            | {{ 'Refresh tab list'|translate }}
        .tab-target-list
            label.tab-target(*ngFor='let t of tabTargets')
                input(type='checkbox', [(ngModel)]='t.checked')
                .tab-target-info
                    .tab-target-name(title='{{t.label}}') {{ t.label }}
                    .tab-target-target.text-muted {{ t.target }}

        .target-group-title.mt-2 {{ 'Log files'|translate }}
        button.btn.btn-sm.btn-secondary.w-100.mb-1(
            type='button',
            (click)='addFiles()'
        )
            i.fas.fa-folder-open.me-1(aria-hidden='true')
            | {{ 'Add log files…'|translate }}
        .file-target-list
            .file-target(*ngFor='let f of fileTargets')
                label
                    input(type='checkbox', [(ngModel)]='f.checked')
                    span.file-target-name(title='{{f.path}}') {{ f.name }}
                button.btn.btn-sm.btn-link.text-danger(
                    type='button',
                    (click)='removeFile(f)'
                ): i.fas.fa-xmark(aria-hidden='true')

        .form-group.mt-2
            label {{ 'Lines per window'|translate }}
            input.form-control.form-control-sm(
                type='number',
                min='50',
                max='5000',
                step='50',
                [(ngModel)]='maxLines'
            )

    .timeline-pane
        .timeline-toolbar
            button.btn.btn-sm.btn-primary(
                type='button',
                [disabled]='!hasTargets || busy',
                (click)='buildTimeline()'
            )
                i.fas.fa-bars-staggered.me-1(aria-hidden='true')
                | {{ 'Build timeline'|translate }}
            button.btn.btn-sm.btn-secondary(
                type='button',
                [disabled]='!timelineText',
                (click)='exportMerged()'
            )
                i.fas.fa-file-export.me-1(aria-hidden='true')
                | {{ 'Export'|translate }}
            button.btn.btn-sm.btn-secondary(
                type='button',
                [disabled]='!timelineText || analyzing',
                (click)='analyzeWithAi()'
            )
                i.fas.fa-robot.me-1(aria-hidden='true')
                | {{ 'Analyze with AI'|translate }}
            span.timeline-stats.text-muted(*ngIf='timeline.length')
                | {{ timeline.length }} {{ 'lines'|translate }} · {{ sourceCount }} {{ 'modules'|translate }}

        .timeline-view
            .text-muted.p-2(*ngIf='!timeline.length') {{ 'Select targets and build the timeline. Logs from all modules will be merged and sorted by time.'|translate }}
            div.timeline-truncated(*ngIf='truncatedRender') {{ 'Only the first 5000 lines are shown; export for the full timeline.'|translate }}
            pre(*ngIf='timeline.length') {{ renderedText }}

        .ai-result(*ngIf='analyzing || aiResult')
            .ai-result-title
                i.fas.fa-robot(aria-hidden='true')
                | {{ 'AI analysis result'|translate }}
                span.spinner-border.spinner-border-sm.ms-2(*ngIf='analyzing', role='status')
            .ai-result-content.pre-wrap-text([class.error]='aiError') {{ aiResult }}

.modal-footer
    button.btn.btn-secondary(type='button', (click)='cancel()') {{ 'Close'|translate }}
