div
    //TODO ([sortablejs]='scripts')
    .input-group.flex-grow-1(*ngFor='let script of scripts')
        input.form-control(
            type='text',
            placeholder='Expect',
            [(ngModel)]='script.expect'
        )
        // AISHELL: 密码行只写不读——已存密码永不回显（SecureCRT 式），保存时写入系统凭据管理器
        input.form-control(
            *ngIf='!isSecret(script)',
            type='text',
            placeholder='Send',
            [(ngModel)]='script.send'
        )
        input.form-control(
            *ngIf='isSecret(script)',
            type='password',
            [placeholder]='passwordPlaceholder(script)',
            [ngModel]='newPasswords.get(script) ?? ""',
            (ngModelChange)='newPasswords.set(script, $event)',
            autocomplete='off'
        )
        .input-group-text.p-0.border-0
            .hover-reveal(ngbDropdown)
                button.btn.btn-link.btn-sm(ngbDropdownToggle)
                    i.fas.fa-fw.fa-cog
                .dropdown-menu-right(ngbDropdownMenu)
                    a.dropdown-item(
                        href='#',
                        (click)='script.isRegex = false',
                        [class.active]='!script.isRegex',
                    )
                        i.fas.fa-fw([class.fa-check]='!script.isRegex')
                        span(translate) Exact match
                    a.dropdown-item(
                        href='#',
                        (click)='script.isRegex = true',
                        [class.active]='script.isRegex',
                    )
                        i.fas.fa-fw([class.fa-check]='script.isRegex')
                        span(translate) Regex
                    a.dropdown-item(
                        href='#',
                        (click)='script.optional = !script.optional',
                        [class.active]='script.optional',
                    )
                        i.fas.fa-fw([class.fa-check]='script.optional')
                        span(translate) Optional
                    // AISHELL: 密码行隐藏开关
                    a.dropdown-item(
                        href='#',
                        (click)='toggleSecret(script)',
                        [class.active]='isSecret(script)',
                    )
                        i.fas.fa-fw([class.fa-check]='isSecret(script)')
                        span(translate) Hide password
            button.btn.btn-link.btn-sm.hover-reveal((click)='deleteScript(script)')
                i.fas.fa-fw.fa-trash-alt

button.btn.btn-secondary.mt-2((click)='addScript()')
    i.fas.fa-plus
    span(translate) New item

// AISHELL: 变量替换提示
.form-text.text-muted.mt-2
    span(translate) Variables in Send: $SERVER_NAME, $SERVER_IP, $SERVER_HOST, $SERVER_PORT, $SERVER_USER and template variables are replaced automatically.
